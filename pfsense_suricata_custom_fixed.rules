# ============================================================
# pfSense / Suricata - Local Web & Network Detection Rules
# Version: 1.0
#
# Purpose:
#   Detect suspicious HTTP payloads and selected network behaviors.
#   These rules inspect payload/traffic patterns, NOT User-Agent strings.
#
# IMPORTANT:
#   - IDS/alert-only rules. They do not block traffic.
#   - Intended for an authorized lab / network you administer.
#   - Tune thresholds for your environment; false positives are possible.
#   - HTTP rules require Suricata to see plaintext HTTP traffic.
#   - HTTPS payloads are encrypted unless TLS is decrypted before inspection.
#   - Rules detect indicators/patterns, not proof of successful exploitation.
#   - HTTP request-body inspection depends on Suricata/libhtp configuration
#     and the version/build in your pfSense package.
#
# Suggested initial deployment:
#   1. Add these rules to the interface's custom rules file/editor.
#   2. Start in IDS/alert-only mode.
#   3. Validate with rule testing and inspect Alerts / eve.json.
#   4. Tune thresholds and exceptions before considering IPS blocking.
#
# SID range used here: 1001001 - 1004004
# ============================================================


# ------------------------------------------------------------
# 1. WEB ATTACKS - SQL INJECTION
# ------------------------------------------------------------

# UNION SELECT pattern in normalized URI
alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible SQLi UNION SELECT in URI"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; distance:0; within:32; nocase; classtype:web-application-attack; sid:1001001; rev:1; )

# Common boolean-based SQL injection pattern in URI
alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible SQLi boolean expression in URI"; flow:established,to_server; http.uri; pcre:"/(?:%27|')\s*(?:or|and)\s+(?:%[0-9a-f]{2}|\s)*(?:[0-9]+|true)\s*=\s*(?:[0-9]+|true)/i"; classtype:web-application-attack; sid:1001002; rev:1; )

# Common time-delay SQL functions in URI
alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible SQLi time-delay function in URI"; flow:established,to_server; http.uri; pcre:"/(?:sleep|benchmark|pg_sleep)\s*\(/i"; classtype:web-application-attack; sid:1001003; rev:1; )

# SQLi indicators in HTTP request body (POST form / body)
alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible SQLi UNION SELECT in request body"; flow:established,to_server; http.request_body; content:"union"; nocase; content:"select"; distance:0; within:32; nocase; classtype:web-application-attack; sid:1001004; rev:1; )

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible SQLi time-delay function in request body"; flow:established,to_server; http.request_body; pcre:"/(?:sleep|benchmark|pg_sleep)\s*\(/i"; classtype:web-application-attack; sid:1001005; rev:1; )


# ------------------------------------------------------------
# 2. WEB ATTACKS - CROSS-SITE SCRIPTING (XSS)
# ------------------------------------------------------------

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible XSS script tag in URI"; flow:established,to_server; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:1001101; rev:1; )

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible XSS event handler in URI"; flow:established,to_server; http.uri; pcre:"/(?:onerror|onload|onclick|onmouseover)\s*=/i"; classtype:web-application-attack; sid:1001102; rev:1; )

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible XSS script tag in request body"; flow:established,to_server; http.request_body; content:"<script"; nocase; classtype:web-application-attack; sid:1001103; rev:1; )

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible XSS event handler in request body"; flow:established,to_server; http.request_body; pcre:"/(?:onerror|onload|onclick|onmouseover)\s*=/i"; classtype:web-application-attack; sid:1001104; rev:1; )


# ------------------------------------------------------------
# 3. WEB ATTACKS - PATH TRAVERSAL / LFI
# ------------------------------------------------------------

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible directory traversal in URI"; flow:established,to_server; http.uri; content:"../"; classtype:web-application-attack; sid:1001201; rev:1; )

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible encoded directory traversal in URI"; flow:established,to_server; http.uri; pcre:"/(?:%2e){2}(?:%2f|\/)|\.\.(?:\/|%2f|\\|%5c)/i"; classtype:web-application-attack; sid:1001202; rev:1; )

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible sensitive local file access in URI"; flow:established,to_server; http.uri; pcre:"/(?:\/etc\/passwd|\/etc\/shadow|boot\.ini|win\.ini)/i"; classtype:web-application-attack; sid:1001203; rev:1; )


# ------------------------------------------------------------
# 4. WEB ATTACKS - COMMAND INJECTION
# ------------------------------------------------------------

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible command injection in URI"; flow:established,to_server; http.uri; pcre:"/(?:;|\||%3b|%7c)\s*(?:whoami|id|uname|cat|wget|curl|bash|sh|powershell)\b/i"; classtype:web-application-attack; sid:1001301; rev:1; )

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible command injection in request body"; flow:established,to_server; http.request_body; pcre:"/(?:;|\||%3b|%7c)\s*(?:whoami|id|uname|cat|wget|curl|bash|sh|powershell)\b/i"; classtype:web-application-attack; sid:1001302; rev:1; )


# ------------------------------------------------------------
# 5. WEB ATTACKS - SSRF INDICATORS
# ------------------------------------------------------------

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible SSRF reference to localhost in URI"; flow:established,to_server; http.uri; pcre:"/https?:\/\/(?:127\.0\.0\.1|localhost|0\.0\.0\.0)(?::[0-9]{1,5})?/i"; classtype:web-application-attack; sid:1001401; rev:1; )

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible SSRF reference to cloud metadata endpoint"; flow:established,to_server; http.uri; content:"169.254.169.254"; classtype:web-application-attack; sid:1001402; rev:1; )


# ------------------------------------------------------------
# 6. WEB ATTACKS - COMMON SENSITIVE ENDPOINT PROBING
#    These are reconnaissance indicators, not vulnerabilities by
#    themselves. Tune/remove paths used legitimately in your lab.
# ------------------------------------------------------------

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Sensitive file or configuration probing"; flow:established,to_server; http.uri; pcre:"/(?:\.env|\.git\/config|wp-config\.php|config\.php|web\.config|phpinfo\.php)(?:[\/?]|$)/i"; classtype:web-application-attack; sid:1001501; rev:1; )


# ------------------------------------------------------------
# 7. WEB LOGIN RATE - POSSIBLE HTTP BRUTE FORCE
#    This detects repeated POST requests to common login paths.
#    It does NOT know whether authentication succeeded or failed.
#    Change the URI pattern to match your application's login route.
# ------------------------------------------------------------

alert http any any -> $HOME_NET any ( msg:"LOCAL WEB - Possible HTTP login brute force by request rate"; flow:established,to_server; http.method; content:"POST"; http.uri; pcre:"/\/(?:login|signin|auth)(?:[\/?]|$)/i"; detection_filter:track by_src, count 10, seconds 60; classtype:web-application-attack; sid:1002001; rev:1; )


# ------------------------------------------------------------
# 8. NETWORK RECONNAISSANCE - TCP SYN SCAN INDICATOR
#    Threshold is a lab starting point; normal high-connection
#    clients may also trigger it.
# ------------------------------------------------------------

alert tcp any any -> $HOME_NET any ( msg:"LOCAL NETWORK - Possible TCP SYN port scan"; flags:S; flow:stateless; detection_filter:track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1003001; rev:1; )


# ------------------------------------------------------------
# 9. DOS INDICATORS - SYN / ICMP / UDP RATE
#    These are rate-based alerts, not reliable DDoS attribution.
#    Distributed attacks may require upstream telemetry and
#    aggregation because each source can remain below threshold.
# ------------------------------------------------------------

alert tcp any any -> $HOME_NET any ( msg:"LOCAL NETWORK - Possible TCP SYN flood"; flags:S; flow:stateless; detection_filter:track by_dst, count 100, seconds 10; classtype:attempted-dos; sid:1003002; rev:1; )

alert icmp any any -> $HOME_NET any ( msg:"LOCAL NETWORK - Possible ICMP echo flood"; itype:8; detection_filter:track by_dst, count 50, seconds 5; classtype:attempted-dos; sid:1003003; rev:1; )

alert udp any any -> $HOME_NET any ( msg:"LOCAL NETWORK - Possible UDP flood"; detection_filter:track by_dst, count 200, seconds 10; classtype:attempted-dos; sid:1003004; rev:1; )


# ------------------------------------------------------------
# 10. NOTES / COVERAGE LIMITATIONS
# ------------------------------------------------------------
# - OWASP Top 10 is not one signature category. Access-control flaws,
#   IDOR, business-logic flaws and many authentication flaws cannot
#   be reliably identified from packet signatures alone.
# - SSH brute-force detection needs SSH authentication logs or
#   suitable protocol/event telemetry; SSH payload is encrypted.
# - HTTP login rate alert above is a heuristic, not failed-login proof.
# - HTTPS application payload inspection requires TLS decryption or
#   visibility at the web server / reverse proxy.
# - A packet path that bypasses the pfSense interface cannot be seen
#   by Suricata on that interface. Ensure traffic traverses the sensor
#   or configure an appropriate network TAP / SPAN / bridge.
# - Test syntax and compatibility with the exact Suricata version
#   bundled in your pfSense package before production use.
# ============================================================
